# Aplicación
APP_NAME=DocMun
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=cambia-esta-clave-en-produccion

# URL pública para el enlace del QR del cargo
PUBLIC_BASE_URL=http://localhost:8000

# Almacenamiento de archivos escaneados
STORAGE_DIR=storage
MAX_UPLOAD_MB=25

# Base de datos (host local para desarrollo sin Docker)
DATABASE_URL=postgresql+psycopg://docmun:docmun@localhost:5433/docmun

# Sesión
SESSION_COOKIE=docmun_session
SESSION_MAX_AGE=28800

# Usuario administrador inicial (solo para el seed)
ADMIN_EMAIL=admin@docmun.local
ADMIN_PASSWORD=admin1234
ADMIN_NOMBRE=Administrador DocMun

# Reglas de semáforo
SLA_POR_VENCER=0.8
SLA_ATRASADO=1.0
SLA_MUY_ATRASADO=1.5

# Cada cuántos segundos corre el job de evaluación de plazos (15 min por defecto)
SLA_INTERVALO_SEGUNDOS=900

# Zona horaria
TIMEZONE=America/Lima

# Análisis de documentos con IA (OCR Tesseract + LayoutLMv3 local)
# El servicio `ia` de docker compose ya trae Tesseract y monta los modelos.
# Ponlo en false si ejecutas la app sin ese servicio (pytest no lo necesita).
IA_HABILITADA=true
IA_MODELOS_DIR=models/ia
IA_MODELO_CLASIFICACION=clasificacion/modelo.pt
# Puedes apuntar a una versión archivada, p. ej. versiones/kie-generico-anterior.pt
IA_MODELO_KIE=kie/modelo.pt
IA_DISPOSITIVO=cpu
IA_HILOS=2
IA_MAX_PAGINAS=3
# 300 mejora el OCR de letra pequeña; 200 es más rápido.
IA_DPI=200
IA_OCR_IDIOMAS=spa+eng
IA_OCR_PSM=3
IA_UMBRAL_SUGERENCIA=0.65
IA_MAX_INTENTOS=3
IA_INTERVALO_SEGUNDOS=5
IA_BORRADOR_HORAS=24
